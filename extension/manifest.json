{
  "manifest_version": 3,
  "name": "Sidecar Monkey",
  "version": "0.1.0",
  "description": "Lets local agents (Hermes Agent, jev-harness, Playwright) drive this browser directly: tabs, click, type, keys, scroll, snapshots, screenshots, JS eval. Talks to the local dt-browser bridge.",
  "minimum_chrome_version": "125",
  "permissions": ["tabs", "scripting", "storage", "alarms", "debugger", "webNavigation"],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sidecar Monkey",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
